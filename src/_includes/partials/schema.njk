{%- set orgId = site.url ~ "/#organization" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ orgId }}",
      "name": "Singer Kitchens",
      "url": "{{ site.url }}/",
      "logo": "{{ site.url }}/images/logo/singer-kitchens-since-1928.png",
      "telephone": "+1-504-539-4605",
      "foundingDate": "1928",
      "sameAs": ["{{ site.social.facebook }}", "{{ site.social.instagram }}"],
      "department": [{% for s in showrooms %}{ "@id": "{{ site.url }}/showrooms/#{{ s.id }}" }{% if not loop.last %}, {% endif %}{% endfor %}]
    }{% if page.url == "/" or page.url == "/showrooms/" %},
    {%- for s in showrooms %}
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": "{{ site.url }}/showrooms/#{{ s.id }}",
      "name": "Singer Kitchens - {{ s.name }}",
      "url": "{{ site.url }}/showrooms/#{{ s.id }}",
      "image": "{{ site.url }}{{ s.photos[0].file | imgSrc }}",
      "logo": "{{ site.url }}/images/logo/singer-kitchens-since-1928.png",
      "telephone": "{{ s.phoneTel | replace('tel:', '') }}",
      "parentOrganization": { "@id": "{{ orgId }}" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ s.street }}",
        "addressLocality": "{{ s.city }}",
        "addressRegion": "{{ s.region }}",
        "postalCode": "{{ s.zip }}",
        "addressCountry": "US"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": {{ s.lat }}, "longitude": {{ s.lng }} },
      "openingHoursSpecification": [{% for h in s.openingHours %}
        { "@type": "OpeningHoursSpecification", "dayOfWeek": {{ h.days | json | safe }}, "opens": "{{ h.opens }}", "closes": "{{ h.closes }}" }{% if not loop.last %},{% endif %}{% endfor %}
      ],
      "hasMap": "{{ s.directions }}"
    }{% if not loop.last %},{% endif %}
    {%- endfor %}{% endif %}{% if layout == "layouts/post.njk" %},
    {
      "@type": "BlogPosting",
      "headline": {{ title | json | safe }},
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ (modified or date) | isoDate }}",
      "mainEntityOfPage": "{{ page.url | absUrl(site.url) }}",
      {%- if image %}"image": "{{ image.src | absUrl(site.url) }}",{% endif %}
      "author": { "@type": "Organization", "name": "Singer Kitchens" },
      "publisher": { "@id": "{{ orgId }}" }
    }{% endif %}{% if cityPage or subService %},
    {%- set saCity = serviceArea | replace(", LA", "") %}
    {%- set saUrl = page.url | absUrl(site.url) %}
    {%- set cityUrl = ("/service-area/" ~ (saCity | lower) ~ "/") | absUrl(site.url) %}
    {
      "@type": "Service",
      "@id": "{{ saUrl }}#service",
      "name": {{ ((subService or "Kitchen & Bathroom Remodeling") ~ " in " ~ serviceArea) | json | safe }},
      "serviceType": {{ (subService or "Kitchen and bathroom remodeling") | json | safe }},
      "url": "{{ saUrl }}",
      "provider": { "@id": "{{ orgId }}" },
      "areaServed": { "@type": "City", "name": "{{ saCity }}", "containedInPlace": { "@type": "State", "name": "Louisiana" } }
      {%- if cityPage %},
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": {{ ("Remodeling services in " ~ serviceArea) | json | safe }},
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": {{ ("Kitchen Design in " ~ serviceArea) | json | safe }}, "url": "{{ saUrl }}kitchen-design/" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": {{ ("Kitchen Remodeling in " ~ serviceArea) | json | safe }}, "url": "{{ saUrl }}kitchen-remodeling/" } }
        ]
      }
      {%- endif %}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "{{ site.url }}/service-area/" },
        { "@type": "ListItem", "position": 3, "name": "{{ saCity }}", "item": "{{ cityUrl }}" }
        {%- if subService %},
        { "@type": "ListItem", "position": 4, "name": "{{ subService }}", "item": "{{ saUrl }}" }
        {%- endif %}
      ]
    }{% endif %}{% if serviceHub %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "{{ site.url }}/service-area/" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Singer Kitchens service areas",
      "itemListElement": [{% for a in serviceAreas.areas | selectattr("url") %}
        { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ (a.name ~ ", LA") | json | safe }}, "url": "{{ a.url | absUrl(site.url) }}" }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }{% endif %}
  ]
}
</script>
