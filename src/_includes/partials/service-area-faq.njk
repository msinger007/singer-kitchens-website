{#- FAQ band for the service-area city pages. Needs `serviceArea` ("Covington, LA") in the page front matter.
    Answers use only facts already on the site (process.json, showrooms.json, financing page). The FAQPage
    structured data below is built from the same list, so the visible answers and the schema always match. -#}
{%- set city = serviceArea | replace(", LA", "") %}
{%- set sr = showrooms | selectattr("id", "equalto", "mandeville") | first %}
{%- set faqs = [
  {
    q: "Do you offer free consultations for kitchen and bathroom remodeling in " ~ serviceArea ~ "?",
    a: "Yes. Call us at " ~ site.phone ~ " or <a href=\"" ~ site.consultUrl ~ "\">request a free consultation online</a>. Tell us what you're thinking about changing, what matters most and the timeline you have in mind. We can also start discussing financing options on that first call.",
    text: "Yes. Call us at " ~ site.phone ~ " or request a free consultation online. Tell us what you're thinking about changing, what matters most and the timeline you have in mind. We can also start discussing financing options on that first call."
  },
  {
    q: "Where is the nearest Singer Kitchens showroom to " ~ city ~ "?",
    a: "Our " ~ sr.name ~ " is at " ~ sr.street ~ " in Old Mandeville, LA " ~ sr.zip ~ ". It's open Monday to Friday 10am to 5pm and Saturday 10am to 2pm by appointment. Call the showroom at <a href=\"" ~ sr.phoneTel ~ "\">" ~ sr.phone ~ "</a> or <a href=\"" ~ sr.directions ~ "\" target=\"_blank\" rel=\"noopener\">get directions</a>. At the showroom you can see and touch real cabinets, materials, finishes and layouts.",
    text: "Our " ~ sr.name ~ " is at " ~ sr.street ~ " in Old Mandeville, LA " ~ sr.zip ~ ". It's open Monday to Friday 10am to 5pm and Saturday 10am to 2pm by appointment. Call the showroom at " ~ sr.phone ~ ". At the showroom you can see and touch real cabinets, materials, finishes and layouts."
  },
  {
    q: "What remodeling services do you provide in " ~ city ~ "?",
    a: "Kitchen design and kitchen remodeling are our specialty, along with <a href=\"/kitchen-cabinets/\">kitchen cabinets</a>, <a href=\"/countertops/\">countertops</a>, <a href=\"/bathrooms/\">bathroom design</a> and <a href=\"/closets/\">closet renovations</a>. Learn more about <a href=\"" ~ page.url ~ "kitchen-design/\">kitchen design in " ~ city ~ "</a> and <a href=\"" ~ page.url ~ "kitchen-remodeling/\">kitchen remodeling in " ~ city ~ "</a>.",
    text: "Kitchen design and kitchen remodeling are our specialty, along with kitchen cabinets, countertops, bathroom design and closet renovations."
  },
  {
    q: "Do you offer financing for kitchen and bathroom remodeling?",
    a: "Yes. Flexible payment plans are available, and we can begin discussing financing options during your first call. See <a href=\"/financing/\">financing</a> for details.",
    text: "Yes. Flexible payment plans are available, and we can begin discussing financing options during your first call."
  },
  {
    q: "What happens after I contact Singer Kitchens?",
    a: "Our process has four steps: " ~ process.steps[0].title ~ " (a phone call), " ~ process.steps[1].title ~ ", " ~ process.steps[2].title ~ ", and " ~ process.steps[3].title ~ ". You don't need to have everything figured out before you start. <a href=\"/our-process/\">See the full process</a>.",
    text: "Our process has four steps: " ~ process.steps[0].title ~ " (a phone call), " ~ process.steps[1].title ~ ", " ~ process.steps[2].title ~ ", and " ~ process.steps[3].title ~ ". You don't need to have everything figured out before you start."
  },
  {
    q: "How long has Singer Kitchens been in business?",
    a: "Since 1928. Singer Kitchens is a local, family-owned business serving " ~ city ~ ", the Northshore, New Orleans and surrounding areas.",
    text: "Since 1928. Singer Kitchens is a local, family-owned business serving " ~ city ~ ", the Northshore, New Orleans and surrounding areas."
  }
] %}
<section class="sa-sec sa-alt sa-faq" aria-labelledby="sa-faq-h">
  <div class="wrap">
    <h2 class="sa-title" id="sa-faq-h">Frequently Asked Questions About Remodeling in {{ serviceArea }}</h2>
    <div class="sa-faq-list">
    {%- for f in faqs %}
      <details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a | safe }}</p></details>
    {%- endfor %}
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{% for f in faqs %}
    { "@type": "Question", "name": {{ f.q | json | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.text | json | safe }} } }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>
