{#- /showrooms/: Step 2 band. -#}
{%- set s2 = process.steps[1] %}
<section class="step2" aria-labelledby="s2-h">
  <div class="wrap step2-in">
    <div>
      <p class="label label-white">Step 2 of the Singer Kitchens Process</p>
      <h2 id="s2-h">{{ s2.title }}</h2>
      <p>{{ s2.lead }}</p>
      <p>{{ s2.body[0] }}</p>
      <p class="callout">{{ s2.body[1] }}</p>
    </div>
    <div>
      <ol class="mini-steps">
      {%- for s in process.steps %}
        <li class="{% if s.n == 2 %}on{% endif %}"><span class="n">{{ s.n }}</span><span>{{ s.title }}</span></li>
      {%- endfor %}
      </ol>
      <a class="link-white" href="/our-process/">See all four steps</a>
    </div>
  </div>
</section>
