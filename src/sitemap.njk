---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.sitemapPages %}
  <url><loc>{{ p.url | absUrl(site.url) }}</loc>{% if p.data.modified %}<lastmod>{{ p.data.modified | isoDate }}</lastmod>{% endif %}</url>
{%- endfor %}
</urlset>
